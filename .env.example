# ---------- LLM ----------
# OpenRouter (OpenAI-compatible) — DeepSeek V3 free tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- Observability ----------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hitl-support-agent
LANGSMITH_TRACING=true
# Region: leave unset for US; set to https://eu.api.smith.langchain.com for EU accounts
LANGSMITH_ENDPOINT=

# ---------- Gmail (real I/O) ----------
# Generate App Password at https://myaccount.google.com/apppasswords (requires 2FA)
GMAIL_USER=support@yourcompany.com
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# ---------- Slack (real approval channel) ----------
# Bot Token from app's "OAuth & Permissions" page (xoxb-...)
SLACK_BOT_TOKEN=
# Signing Secret from app's "Basic Information" page
SLACK_SIGNING_SECRET=
# App Token from app's "Basic Information > App-Level Tokens" page (xapp-...) — Socket Mode only
SLACK_APP_TOKEN=

# 3-channel set (cut from spec's 6 — config-driven, see adviserplan.md)
SLACK_CHANNEL_REFUNDS=#support-refunds
SLACK_CHANNEL_TECHNICAL=#support-technical
SLACK_CHANNEL_COMPLAINTS=#support-complaints

# ---------- Persistence ----------
SQLITE_CHECKPOINT_PATH=./data/checkpoints.sqlite

# ---------- PII vault (durable execution) ----------
# Empty (default) → vault lives only in process memory, matching the
# C1/C2 audit hardening from 2026-05-09 (real recipient + token-map
# never on disk, never to LangSmith).
# Non-empty → SQLite sidecar persists envelope_from + token_map so a
# ticket paused at the Interrupt Gate can resume after process death.
# Required for the "kill mid-interrupt + resume" durable-execution demo.
# Trade-off: PII at rest in plaintext SQLite. Mitigate with disk
# encryption / restricted file ACL. See docs/threat_model.md A1.
PII_VAULT_DB_PATH=

# ---------- Tunables (defaults match CLAUDE.md) ----------
REVALIDATE_THRESHOLD_MIN=15
MAX_HUMAN_REJECTIONS=3
MAX_SEND_RETRIES=3
SLA_DEADLINE_HOURS=24
IMAP_POLL_INTERVAL_SEC=30

# ---------- Server ----------
# Code default is 127.0.0.1 (loopback only) — bandit B104 safer default for
# dev. Production / container deploys must set HOST=0.0.0.0 explicitly to
# accept external traffic. See docs/threat_model.md row A5 for the rationale.
HOST=0.0.0.0
PORT=8000

# ---------- v4 multi-agent (Researcher + Drafter ↔ Critic) ----------
# 0 = v3 single-agent. 1 = v4 multi-agent (default). See docs/v4_multiagent.md.
# Default flipped to v4 on 2026-05-23 — bitext27 + adversarial evals show v4
# catches 5/6 dangerous false auto-sends v3 missed (invoice queries, order
# tracking, etc.) and 3 more classifier-trap cases on the red-team set.
# Trade-off documented in eval/bitext27_findings.md: v4 costs ~2× per ticket
# and over-escalates some simple FAQs. Set =0 to recover the v3 single-agent
# baseline for direct comparison.
MULTIAGENT_ENABLED=1
# Per-agent model overrides for A/B experiments — leave blank to use OPENROUTER_MODEL.
RESEARCHER_MODEL_OVERRIDE=
DRAFTER_MODEL_OVERRIDE=
CRITIC_MODEL_OVERRIDE=
